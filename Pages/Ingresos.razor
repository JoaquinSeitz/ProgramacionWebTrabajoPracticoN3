@page "/ingresos"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@using System.Security.Claims
@using ProgramacionWebTrabajoPracticoN3.Services
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-16">
    <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" GutterBottom="true"><b>Gestión de Inventario</b></MudText>

    <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">

        <!-- ========================================== -->
        <!-- PESTAÑA 1: OPERACIONES (TU CÓDIGO ORIGINAL)-->
        <!-- ========================================== -->
        <MudTabPanel Text="Ingresos y Bajas" Icon="@Icons.Material.Filled.LocalShipping">
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Busque el producto y seleccione el proveedor para registrar ingresos de stock o darlo de baja del catálogo.
            </MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Info" Class="mb-4">
                Productos activos: @productos.Count
            </MudText>

            <MudGrid>
                @* 1. Buscador de Producto *@
                <MudItem xs="12" md="5">
                    <div style="position: relative; flex-grow: 1;">
                        <MudTextField T="string"
                                      Label="Buscar Producto Activo"
                                      @bind-Value="txtBusqueda"
                                      @bind-Value:after="AlEscribir"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      @onfocus="MostrarListaCompleta" />
                        @if (mostrarDropdown && sugerencias.Any())
                        {
                            <MudPaper Elevation="4" Style="position: absolute; top: 100%; left: 0; right: 0; z-index: 100; max-height: 250px; overflow-y: auto;">
                                <MudList T="ProductoResponseDTO" Clickable="true">
                                    @foreach (var prod in sugerencias)
                                    {
                                        <MudListItem OnClick="() => SeleccionarProducto(prod)">
                                            <MudText>
                                                @prod.Nombre
                                                <MudChip T="string" Size="Size.Small" Style="background-color: #ECEFF1; color: #546E7A;" Class="ms-2">Stock: @prod.Stock</MudChip>
                                            </MudText>
                                        </MudListItem>
                                    }
                                </MudList>
                            </MudPaper>
                        }
                    </div>
                </MudItem>

                @* 2. Selector de Proveedor *@
                <MudItem xs="12" md="4">
                    <MudSelect T="int" @bind-Value="_proveedorSeleccionadoId" Label="Proveedor" Variant="Variant.Outlined">
                        <MudSelectItem Value="0" Disabled="true">Seleccione Proveedor</MudSelectItem>
                        @foreach (var prov in proveedores)
                        {
                            <MudSelectItem Value="@prov.ProveedorId">@prov.RazonSocial</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* 3. Cantidad y Botón Nuevo *@
                <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
                    <MudNumericField T="int" Label="Cantidad" @bind-Value="cantidadAIngresar" Variant="Variant.Outlined" Min="1" Max="1000" />
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" OnClick="AbrirModalNuevoProducto" Title="Crear Nuevo Producto" />
                </MudItem>

                @* Botones centrados *@
                <MudItem xs="12" Class="d-flex justify-center mt-4 gap-3">
                    @if (productoSeleccionado != null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeshabilitarProducto" Disabled="@_cargando">
                            Deshabilitar
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Save" OnClick="RegistrarIngreso" Disabled="@_cargando" Class="mud-elevation-8">
                        @if (_cargando)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                            <MudText Class="ms-2">Procesando...</MudText>
                        }
                        else
                        {
                            <MudText>Registrar Ingreso</MudText>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>


        <!-- ========================================== -->
        <!-- PESTAÑA 2: MANTENIMIENTO (NUEVA FUNCIÓN)   -->
        <!-- ========================================== -->
        <MudTabPanel Text="Mantenimiento y Reactivación" Icon="@Icons.Material.Filled.SettingsSuggest">
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Busque productos deshabilitados para darlos de alta nuevamente, o corrija errores de inventario actualizando el stock manualmente.
            </MudText>

            <MudGrid>
                @* Buscador de Inactivos *@
                <MudItem xs="12" md="6">
                    <div style="position: relative; flex-grow: 1;">
                        <MudTextField T="string"
                                      Label="Buscar Producto Inactivo"
                                      @bind-Value="txtBusquedaInactivo"
                                      @bind-Value:after="AlEscribirInactivo"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.SearchOff"
                                      @onfocus="MostrarListaCompletaInactivos" />
                        @if (mostrarDropdownInactivos && sugerenciasInactivas.Any())
                        {
                            <MudPaper Elevation="4" Style="position: absolute; top: 100%; left: 0; right: 0; z-index: 100; max-height: 250px; overflow-y: auto;">
                                <MudList T="ProductoResponseDTO" Clickable="true">
                                    @foreach (var prod in sugerenciasInactivas)
                                    {
                                        <MudListItem OnClick="() => SeleccionarProductoInactivo(prod)">
                                            <MudText Color="Color.Error">
                                                @prod.Nombre
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ms-2">Baja</MudChip>
                                            </MudText>
                                        </MudListItem>
                                    }
                                </MudList>
                            </MudPaper>
                        }
                    </div>
                </MudItem>

                <MudItem xs="12" md="6" Class="d-flex align-center">
                    @if (productoInactivoSeleccionado != null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" StartIcon="@Icons.Material.Filled.Restore" OnClick="ReactivarProducto" FullWidth="true" Disabled="@_cargando">
                            Dar de Alta Nuevamente
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" />

            <MudText Typo="Typo.subtitle1" Color="Color.Warning" Class="mb-3"><b>Ajuste Manual de Stock (Para Auditorías)</b></MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <!-- Usamos el mismo buscador de productos activos para corregir stock -->
                    <MudAutocomplete T="ProductoResponseDTO"
                                     Label="Seleccione un producto activo"
                                     @bind-Value="productoAjusteSeleccionado"
                                     SearchFunc="BuscarParaAjuste"
                                     ToStringFunc="@(p => p == null ? null : p.Nombre)"
                                     Variant="Variant.Outlined"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="int" Label="Nuevo Stock Fijo" @bind-Value="nuevoStockManual" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large" StartIcon="@Icons.Material.Filled.Sync" OnClick="AjustarStockManual" FullWidth="true" Disabled="@(productoAjusteSeleccionado == null || _cargando)">
                        Sobrescribir
                    </MudButton>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-6" />

            <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="mb-3"><b>Actualización Rápida de Precio</b></MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <!-- Reutilizamos el mismo buscador inteligente -->
                    <MudAutocomplete T="ProductoResponseDTO"
                                     Label="Seleccione un producto activo"
                                     Value="productoPrecioSeleccionado"
                                     ValueChanged="OnProductoPrecioSeleccionado"
                                     SearchFunc="BuscarParaAjuste"
                                     ToStringFunc="@(p => p == null ? null : p.Nombre)"
                                     Variant="Variant.Outlined"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="decimal" Label="Nuevo Precio ($)" @bind-Value="nuevoPrecioManual" Variant="Variant.Outlined" Min="0.01M" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" StartIcon="@Icons.Material.Filled.PriceChange" OnClick="AjustarPrecioManual" FullWidth="true" Disabled="@(productoPrecioSeleccionado == null || _cargando)">
                        Actualizar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@* --- MODAL PARA CREAR NUEVO PRODUCTO (INTACTO) --- *@
<MudDialog @bind-Visible="_modalProductoVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2" /> Nuevo Producto
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_formProducto" Model="@_nuevoProducto">
            <MudTextField @bind-Value="_nuevoProducto.Nombre" For="@(() => _nuevoProducto.Nombre)" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <div class="d-flex gap-3 mb-3">
                <MudNumericField @bind-Value="_nuevoProducto.Precio" For="@(() => _nuevoProducto.Precio)" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                <MudNumericField @bind-Value="_nuevoProducto.Stock" For="@(() => _nuevoProducto.Stock)" Label="Stock Inicial" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </div>

            <div class="d-flex gap-3 mb-3">
                <MudSelect T="int" @bind-Value="_nuevoProducto.CategoriaId" For="@(() => _nuevoProducto.CategoriaId)" Label="Categoría" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var cat in categorias)
                    {
                        <MudSelectItem Value="@cat.CategoriaId">@cat.Nombre</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int" @bind-Value="_nuevoProducto.ProveedorId" For="@(() => _nuevoProducto.ProveedorId)" Label="Proveedor Inicial" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_nuevoProducto.Stock <= 0)">
                    <MudSelectItem Value="0" Disabled="true">Seleccione Proveedor</MudSelectItem>
                    @foreach (var prov in proveedores)
                    {
                        <MudSelectItem Value="@prov.ProveedorId">@prov.RazonSocial</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudFileUpload T="IBrowserFile" FilesChanged="CargarImagen" Accept=".jpg, .jpeg, .png, .webp">
                <ActivatorContent>
                    <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudUpload">
                        Subir Foto (Opcional)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (_archivoImagen != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Success" Class="d-block mt-1">Archivo listo: @_archivoImagen.Name</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _modalProductoVisible = false">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarNuevoProducto" Disabled="@_guardandoProducto">
            @if (_guardandoProducto)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar Producto</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // --- VARIABLES GENERALES ---
    private bool _cargando = false;
    private List<CategoriaResponseDTO> categorias = new();
    private List<ProveedorResponseDTO> proveedores = new();

    // --- VARIABLES PESTAÑA 1 (ACTIVOS) ---
    private int cantidadAIngresar = 1;
    private int _proveedorSeleccionadoId = 0;
    private List<ProductoResponseDTO> productos = new();
    private ProductoResponseDTO? productoSeleccionado;
    private string txtBusqueda = "";
    private bool mostrarDropdown = false;
    private List<ProductoResponseDTO> sugerencias = new();

    // --- VARIABLES PESTAÑA 2 (MANTENIMIENTO) ---
    private List<ProductoResponseDTO> productosInactivos = new();
    private ProductoResponseDTO? productoInactivoSeleccionado;
    private string txtBusquedaInactivo = "";
    private bool mostrarDropdownInactivos = false;
    private List<ProductoResponseDTO> sugerenciasInactivas = new();
    // Variables Ajuste de Precio
    private ProductoResponseDTO? productoPrecioSeleccionado;
    private decimal nuevoPrecioManual = 0;

    // Variables Ajuste de Stock
    private ProductoResponseDTO? productoAjusteSeleccionado;
    private int nuevoStockManual = 0;

    // --- VARIABLES MODAL NUEVO ---
    private bool _modalProductoVisible;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private MudForm _formProducto = default!;
    private ProductoCreateDTO _nuevoProducto = new();
    private bool _guardandoProducto = false;
    private IBrowserFile? _archivoImagen;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        await CargarProveedores();
        await CargarCategorias();
        await CargarProductos(); // Carga Activos
        await CargarProductosInactivos(); // Carga Inactivos
    }

    // ==========================================
    // MÉTODOS DE CARGA Y BÚSQUEDA
    // ==========================================
    private async Task CargarProveedores()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ProveedorResponseDTO>>("/api/Proveedores/lista") ?? await Http.GetFromJsonAsync<List<ProveedorResponseDTO>>("/api/Proveedores?pageSize=100");
            if (response != null) proveedores = response;
        }
        catch (Exception) { /* Manejado por default vacío */ }
    }

    private async Task CargarCategorias()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<CategoriaResponseDTO>>("/api/Categorias/lista") ?? await Http.GetFromJsonAsync<List<CategoriaResponseDTO>>("/api/Categorias");
            if (response != null && response.Any()) categorias = response;
        }
        catch (Exception) { }
    }

    private async Task CargarProductos()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ProductoResponseDTO>>("/api/Productos?pageSize=1000");
            if (response != null)
            {
                productos = response;
                sugerencias = productos;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar activos: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarProductosInactivos()
    {
        try
        {
            // Apunta al nuevo endpoint que haremos en el backend
            var response = await Http.GetFromJsonAsync<List<ProductoResponseDTO>>("/api/Productos/inactivos");
            if (response != null)
            {
                productosInactivos = response;
                sugerenciasInactivas = productosInactivos;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Silencioso, puede que el endpoint no exista aún
        }
    }

    // Buscador Activos
    private void AlEscribir()
    {
        productoSeleccionado = null;
        sugerencias = string.IsNullOrWhiteSpace(txtBusqueda) ? productos : productos.Where(p => p.Nombre.Contains(txtBusqueda, StringComparison.InvariantCultureIgnoreCase)).ToList();
        mostrarDropdown = true;
    }
    private void MostrarListaCompleta() { sugerencias = string.IsNullOrWhiteSpace(txtBusqueda) ? productos : sugerencias; mostrarDropdown = true; }
    private void SeleccionarProducto(ProductoResponseDTO prod) { productoSeleccionado = prod; txtBusqueda = prod.Nombre; mostrarDropdown = false; }

    // Buscador Inactivos
    private void AlEscribirInactivo()
    {
        productoInactivoSeleccionado = null;
        sugerenciasInactivas = string.IsNullOrWhiteSpace(txtBusquedaInactivo) ? productosInactivos : productosInactivos.Where(p => p.Nombre.Contains(txtBusquedaInactivo, StringComparison.InvariantCultureIgnoreCase)).ToList();
        mostrarDropdownInactivos = true;
    }
    private void MostrarListaCompletaInactivos() { sugerenciasInactivas = string.IsNullOrWhiteSpace(txtBusquedaInactivo) ? productosInactivos : sugerenciasInactivas; mostrarDropdownInactivos = true; }
    private void SeleccionarProductoInactivo(ProductoResponseDTO prod) { productoInactivoSeleccionado = prod; txtBusquedaInactivo = prod.Nombre; mostrarDropdownInactivos = false; }

    // Buscador MudAutocomplete (Para ajuste de stock)
    private async Task<IEnumerable<ProductoResponseDTO>> BuscarParaAjuste(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return productos;
        return productos.Where(p => p.Nombre.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }


    // ==========================================
    // MÉTODOS DE LA PESTAÑA 1 (INGRESOS Y BAJAS)
    // ==========================================
    private async Task RegistrarIngreso()
    {
        if (productoSeleccionado == null || _proveedorSeleccionadoId == 0 || cantidadAIngresar <= 0)
        {
            Snackbar.Add("Faltan datos para el ingreso.", Severity.Warning);
            return;
        }

        int nuevoStock = productoSeleccionado.Stock + cantidadAIngresar;
        bool? confirmado = await DialogService.ShowMessageBox("Validación", $"¿Agregar {cantidadAIngresar} unidades a {productoSeleccionado.Nombre}?", yesText: "Confirmar", cancelText: "Cancelar");
        if (confirmado != true) return;

        _cargando = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            int usuarioLogueadoId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "1");

            var dto = new IngresoProductoRequestDTO
            {
                ProveedorId = _proveedorSeleccionadoId,
                UsuarioId = usuarioLogueadoId,
                Detalles = new List<DetalleMovimientoRequestDTO> { new DetalleMovimientoRequestDTO { ProductoId = productoSeleccionado.ProductoId, Cantidad = cantidadAIngresar } }
            };

            var response = await Http.PostAsJsonAsync("/api/IngresoProductos", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ingreso registrado.", Severity.Success);
                productoSeleccionado = null; txtBusqueda = ""; cantidadAIngresar = 1; _proveedorSeleccionadoId = 0;
                await CargarProductos();
            }
        }
        finally { _cargando = false; }
    }

    private async Task DeshabilitarProducto()
    {
        if (productoSeleccionado == null) return;
        bool? confirmado = await DialogService.ShowMessageBox("Baja", $"¿Deshabilitar {productoSeleccionado.Nombre}?", yesText: "Sí, Deshabilitar", cancelText: "Cancelar");
        if (confirmado != true) return;

        _cargando = true;
        try
        {
            var response = await Http.DeleteAsync($"/api/Productos/{productoSeleccionado.ProductoId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto deshabilitado.", Severity.Success);
                productoSeleccionado = null; txtBusqueda = "";
                await CargarProductos();
                await CargarProductosInactivos(); // Recargamos para que aparezca en la otra pestaña
            }
        }
        finally { _cargando = false; }
    }


    // ==========================================
    // MÉTODOS DE LA PESTAÑA 2 (NUEVOS MÉTODOS)
    // ==========================================
    private async Task ReactivarProducto()
    {
        if (productoInactivoSeleccionado == null) return;

        bool? confirmado = await DialogService.ShowMessageBox(
            "Reactivación de Producto",
            $"¿Está seguro de volver a dar de alta '{productoInactivoSeleccionado.Nombre}'?\nEl producto volverá a estar disponible para la venta.",
            yesText: "Sí, Dar de Alta", cancelText: "Cancelar"
        );

        if (confirmado != true) return;

        _cargando = true;
        try
        {
            // Llama al nuevo endpoint del backend
            var response = await Http.PutAsync($"/api/Productos/reactivar/{productoInactivoSeleccionado.ProductoId}", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto reactivado con éxito.", Severity.Success);
                productoInactivoSeleccionado = null;
                txtBusquedaInactivo = "";

                // Actualizamos ambas listas
                await CargarProductos();
                await CargarProductosInactivos();
            }
            else
            {
                Snackbar.Add("No se pudo reactivar. Verifique el backend.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AjustarStockManual()
    {
        if (productoAjusteSeleccionado == null) return;

        bool? confirmado = await DialogService.ShowMessageBox(
            "Alerta de Auditoría",
            $"Atención: Va a sobrescribir el stock de '{productoAjusteSeleccionado.Nombre}'.\nEl stock pasará de {productoAjusteSeleccionado.Stock} a {nuevoStockManual} sin generar registro de compra o venta.\n¿Confirma esta corrección manual?",
            yesText: "Sí, Sobrescribir Stock", cancelText: "Cancelar"
        );

        if (confirmado != true) return;

        _cargando = true;
        try
        {
            // Enviamos el nuevo stock al backend como un JSON plano
            var payload = new { NuevoStock = nuevoStockManual };
            var response = await Http.PutAsJsonAsync($"/api/Productos/actualizar-stock/{productoAjusteSeleccionado.ProductoId}", payload);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Inventario corregido manualmente.", Severity.Success);
                productoAjusteSeleccionado = null;
                nuevoStockManual = 0;
                await CargarProductos(); // Recarga la lista para mostrar el nuevo stock
            }
            else
            {
                Snackbar.Add("Error al actualizar el stock.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }
    // Autocompleta el precio actual cuando el usuario selecciona un producto
    private void OnProductoPrecioSeleccionado(ProductoResponseDTO prod)
    {
        productoPrecioSeleccionado = prod;
        if (prod != null) nuevoPrecioManual = prod.Precio;
        else nuevoPrecioManual = 0;
    }

    private async Task AjustarPrecioManual()
    {
        if (productoPrecioSeleccionado == null || nuevoPrecioManual <= 0) return;

        bool? confirmado = await DialogService.ShowMessageBox(
            "Actualización de Precio",
            $"El precio de '{productoPrecioSeleccionado.Nombre}' pasará de ${productoPrecioSeleccionado.Precio:N2} a ${nuevoPrecioManual:N2}.\n¿Confirma la actualización?",
            yesText: "Sí, Actualizar Precio", cancelText: "Cancelar"
        );

        if (confirmado != true) return;

        _cargando = true;
        try
        {
            var payload = new { NuevoPrecio = nuevoPrecioManual };
            var response = await Http.PutAsJsonAsync($"/api/Productos/actualizar-precio/{productoPrecioSeleccionado.ProductoId}", payload);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Precio actualizado correctamente.", Severity.Success);
                productoPrecioSeleccionado = null;
                nuevoPrecioManual = 0;
                await CargarProductos(); // Recargamos para que el nuevo precio impacte en la caja registradora de inmediato
            }
            else
            {
                Snackbar.Add("Error al actualizar el precio.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    // ==========================================
    // MÉTODOS DEL MODAL DE ALTA NUEVO PRODUCTO
    // ==========================================
    private void AbrirModalNuevoProducto() { _nuevoProducto = new ProductoCreateDTO { ProveedorId = 0 }; _archivoImagen = null; _modalProductoVisible = true; }
    private void CargarImagen(IBrowserFile file) { _archivoImagen = file; }

    private async Task GuardarNuevoProducto()
    {
        if (_nuevoProducto.Stock == 0) _nuevoProducto.ProveedorId = 1;
        await _formProducto.Validate();
        if (!_formProducto.IsValid) return;

        _guardandoProducto = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/Productos", _nuevoProducto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto creado.", Severity.Success);
                _modalProductoVisible = false;
                await CargarProductos();
            }
        }
        finally { _guardandoProducto = false; }
    }

